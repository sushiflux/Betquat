backend/bin/
backend/obj/
backend/**/bin/
backend/**/obj/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*

# IDE / Editor
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
