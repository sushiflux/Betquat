# Vorlage/Dokumentation der verfuegbaren Variablen - keine echten Werte hier (siehe CLAUDE.md
# "Secrets management fuer lokale Docker Compose Stacks"). start.ps1 erzeugt bei Bedarf eine
# echte .env mit den unten dokumentierten Nicht-Secret-Werten; das Postgres-Passwort selbst wird
# NICHT ueber .env, sondern als generierte Datei unter ./secrets/postgres_password.txt verwaltet
# und per Docker-Compose-Secret in die Container gemountet.

POSTGRES_DB=betquote
POSTGRES_USER=betquote

# football-data.org API-Key (Primaerquelle fuer La Liga, siehe PREDICTION_FACTORS.md/TECH_STACK.md
# "Ziel-Wettbewerbe"/"Datenquellen") - kostenloser Tier, muss manuell registriert werden unter
# https://www.football-data.org/client/register (kein automatisierbarer Registrierungsprozess,
# siehe CLAUDE.md "Secrets management": externe Provider-Keys sind von der Auto-Generierung
# ausgenommen). Ohne gesetzten Key ueberspringt der La-Liga-Import sich selbst mit einer klaren
# Log-Meldung, der Rest der App (1./2. Bundesliga ueber OpenLigaDB) laeuft unbeeintraechtigt weiter.
FOOTBALL_DATA_ORG_API_KEY=

# Ports - werden von start.ps1 aus der globalen Registry (~/.claude/ports.json, Projekt
# "betquote") automatisch eingetragen, hier nur zur Dokumentation der verfuegbaren Variablen.
POSTGRES_PORT=5194
BACKEND_PORT=5193
FRONTEND_PORT=5192
CADDY_HTTP_PORT=5190
CADDY_HTTPS_PORT=5191
