# Baut die statischen Produktions-Assets. Caddy (siehe docker/caddy/Caddyfile.prod) mountet
# das Ergebnis und liefert es direkt aus - kein eigener nginx/Node-Server im Prod-Profil noetig.

FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

FROM scratch AS export
COPY --from=build /app/dist /dist
