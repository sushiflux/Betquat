FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

COPY BetQuote.Api.csproj .
RUN dotnet restore "BetQuote.Api.csproj"

COPY . .

ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
# dotnet watch fragt bei "rude edits" (z.B. neue DI-Registrierungen/HostedServices, geaenderte
# Compiler-Features) interaktiv "Restart? y/n" - in einem Container ohne TTY-Eingabe blockiert das
# nie die App selbst (der zuletzt laufende Prozess bleibt aktiv), verhindert aber, dass die
# Aenderung tatsaechlich uebernommen wird, bis manuell neu gestartet wird. Automatischer Restart
# ohne Nachfrage ist im Dev-Container unproblematisch (kein Nutzer sitzt interaktiv davor).
ENV DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1
EXPOSE 8080

# dotnet watch fuer Hot Reload im Dev-Profil (Quellcode wird per Volume gemountet,
# siehe docker-compose.dev.yml).
ENTRYPOINT ["dotnet", "watch", "run", "--no-launch-profile", "--urls", "http://+:8080"]
