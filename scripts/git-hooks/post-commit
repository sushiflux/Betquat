#!/bin/sh
# Aktualisiert version.txt nach jedem Commit und stempelt die neueste Ueberschrift des
# privaten Dev-Changelogs (intern/CHANGELOG.dev.md) mit Datum/Uhrzeit.
# Danach sichert der Hook den git-ignorierten Ordner intern/ ueber das lokal konfigurierte Kommando.
#
# Versionsformat: vYear.Month.CommitOfTheYear (kein Zero-Padding, kein Tages-Segment). Der
# letzte Teil zaehlt alle Commits seit Jahresbeginn (nicht die Gesamtzahl im Repo und nicht pro
# Tag), damit er einmal pro Kalenderjahr bei 1 neu beginnt und dazwischen ein sinnvolles "wie
# viele Commits dieses Jahr" bleibt.
#
# version.txt laeuft dadurch dem jeweils letzten Commit bewusst um genau einen Stand voraus: der
# Hook schreibt NACH dem Commit, der naechste Commit nimmt die Aenderung (Datei-Aenderung selbst)
# mit in den Verlauf. Kein "git add"/"commit --amend" hier (das wuerde post-commit rekursiv
# erneut ausloesen).

set -e

repo_root=$(git rev-parse --show-toplevel)
year=$(date +%Y)
date_part=$(date +%Y.%-m)
commits_this_year=$(git rev-list --count HEAD --since="${year}-01-01T00:00:00")

version="v${date_part}.${commits_this_year}"

printf '%s' "$version" > "$repo_root/version.txt"
# Auch fuers Backend-Docker-Image mitfuehren, damit ein lokaler "dotnet run" (ausserhalb von
# Docker) ebenfalls die aktuelle Version liest, ohne extra Volume-Mount - siehe
# backend/Controllers/VersionController.cs.
cp "$repo_root/version.txt" "$repo_root/backend/version.txt" 2>/dev/null || true

# intern/CHANGELOG.dev.md (private developer changelog, optional - a missing file means nothing
# happens): stamp the newest version heading of each language section (first "## v..." line after
# the respective "# English"/"# Deutsch" heading) with date and time, so the exact commit time does
# not have to be guessed while preparing the entry.
changelog="$repo_root/intern/CHANGELOG.dev.md"
if [ -f "$changelog" ]; then
    stamp=$(date "+%Y-%m-%d %H:%M")
    tmp=$(mktemp)
    awk -v ver="$version" -v stamp="$stamp" '
        /^# / { in_section = 1; stamped = 0 }
        in_section && !stamped && /^## v/ {
            print "## " ver " - " stamp
            stamped = 1
            next
        }
        { print }
    ' "$changelog" > "$tmp" && mv "$tmp" "$changelog"
fi

# The git-ignored intern/ folder (private notes, never part of this repository) is backed up by the command named in the local git
# config key intern.sync, if one is set, with this commit's version as the message. It runs in the background and may never fail
# or block the commit that ran the hook.
sync=$(git config --get intern.sync 2>/dev/null || true)
if [ -n "$sync" ] && [ -d "$repo_root/intern" ]; then
    message=$(sed -n '1p' "$repo_root/version.txt" 2>/dev/null | tr -d '\r')
    [ -n "$message" ] || message="update"
    (
        # The hook runs with GIT_DIR/GIT_INDEX_FILE of this repository - the backup command must not inherit them
        unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
        sh -c "$sync save \"\$1\" --message \"\$2\"" intern-sync "$repo_root" "$message" >/dev/null 2>&1 &
    ) || true
fi

exit 0
